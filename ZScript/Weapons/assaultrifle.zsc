class Halo_AR_Clip : Ammo 
{
	Default 
	{
		Inventory.MaxAmount 32;
	}
}
class Halo_AR_Reserves : Ammo
{
	mixin WorldAmmoBehavior;
	Default 
	{
		Radius 8;
		Height 6;
		Scale 0.65;

		Inventory.Amount 32;
		Inventory.MaxAmount 320;
		Inventory.Icon "HLAMA0";
		Inventory.PickupSound "Halo/Pickup/Ammo";
		Inventory.PickupMessage "Picked up 32 Rounds for the Assault Rifle";
		
		Ammo.BackpackMaxAmount 480;
	}
	
	States
	{
		Spawn:
			HLAM A -1 Bright;
		stop;
	}
}

class HaloRifle_Bullet : HaloBullet 
{
	Default
	{
		HaloProjectile.SetRanges ARIFLE_RANGE1, ARIFLE_RANGE2;
		HaloProjectile.MinRangeDamage ARIFLE_MINDMG; 
		HaloProjectile.BaseDamage ARIFLE_DMG;
		HaloProjectile.Speed_MPS ARIFLE_BMPS;
		HaloProjectile.HeadshotDMGFactor ARIFLE_HEDMOD;
		Scale 0.5;
	}
}

class Halo_AssaultRifle : HaloGun 
{
	const LCD_LLayer = 20;
	const LCD_RLayer = 21;
	const LCD_CLayer = 22;
	vector2 lcd_offs;
	double testang;
	
	Default
	{
		//$Category "HaloDoom/Weapons"
		Weapon.SlotNumber 1;
		Obituary "%o learned the Rifleman's Creed from %k's Assault Rifle.";
		Inventory.PickupMessage	"Picked up the MA37 Assault Rifle.";
		Tag "Assault Rifle";
		Weapon.BobSpeed 2.45;
		Weapon.BobRangeX 0.30;
		Weapon.AmmoType1 "Halo_AR_Reserves";
		Weapon.AmmoType2 "Halo_AR_Clip";
		Weapon.AmmoGive 96;
		HaloGun.Faction "Human";
				
		// Recoil
		HaloGun.Bloom 0.32;
		HaloGun.BloomSpeed 0.45;
		HaloGun.BaseRecoil ARIFLE_RECOIL;
		HaloGun.Inaccuracy ARIFLE_ACCMOD;
		HaloGun.Crosshair "RifleRet", 1.0;
		HaloGun.UIGraphic "WI_AR", 1.0, 1.0;
		HaloGun.SetupUIAmmo "WI_AMM7", 12, 14, 0, 8;
		
		HaloGun.PowerTier P_NORM;
		
		RecoilWeapon.YOffsetRange 0, 40;
	}

	override void GetStatsLore(out Array<String> stats, out string lore)
	{
		stats.Push("MA37 Individual Combat Weapon System");
		stats.Push("Ammo Type: Misriah Armory 7.62x51mm");
		stats.Push("Frame: Bullpup");
		stats.Push("Feed System: 32 Round Mag");
		stats.Push(String.Format("Base Damage: %d", ARIFLE_DMG));
		
		lore = (
			"The MA37 is The predicessor of the MA40. "
			"Gas Operated and Air Cooled, with a 32 round magazine on a bullpup "
			"frame based on the MA5 Family. It’s the workhorse of the UNSC, and is "
			"held in high regard by the Army Branch. Due to it being Air Cooled, "
			"it is not usable in space due to the lack of atmosphere for the heat "
			"to radiate, and thus is prone to overheating. "
		);
	}
	
	override void MarkPrecacheSounds()
	{
		// Prevent stutters by precaching weapon sounds.
		MarkSound("Halo/Weapons/Rifle/Fire");
		MarkSound("Halo/Weapons/Rifle/Fire/Bass");
		MarkSound("Halo/Weapons/Rifle/Mech");
		MarkSound("Halo/Weapons/Rifle/Reload/Full");
		MarkSound("Halo/Weapons/Rifle/Reload/Empty");
		MarkSound("Halo/Weapons/Rifle/Select");
	}
	
	action void A_FireRifle()
	{
		A_Light(2);
		A_WeapSound("Halo/Weapons/Rifle/Fire", CHANF_OVERLAP, true);
		A_WeapSound("Halo/Weapons/Rifle/Fire/Bass", CHANF_OVERLAP, true);
		A_ShootProjectile("HaloRifle_Bullet", 6);		
		A_SetSFXPos(20,-18,-12);
		A_SpawnSFX("RifleCasing", -90,-20);
		A_SetSFXPos(25,-10,-8);
		A_SpawnSFX("MuzzleSmoke", 0,0);
		A_TakeAmmo();
		A_UpdateSpread();
	}
	
	action void A_DisableLCD()
	{
		A_Overlay(LCD_LLayer, "LCD_Off");
		A_Overlay(LCD_RLayer, "LCD_Off");
		A_Overlay(LCD_CLayer, "LCD_Off");
	}
	
	action void A_ReloadSound()
	{
		Sound reload_snd = "Halo/Weapons/Rifle/Reload/Full";
		if(!CountLoadedAmmo()) reload_snd = "Halo/Weapons/Rifle/Reload/Empty";
		A_StartSound(reload_snd, CHAN_RELOADING, CHANF_OVERLAP);
	}
	
	action void A_LCDOffset(double x, double y)
	{
		x += -27.5; y += -10;
		invoker.lcd_offs = (x,y);
	}
	
	States
	{
		Ready:
			TNT1 A 0 
			{
				A_WeapSound("Halo/Weapons/Rifle/Select");
				return A_JumpIf(A_DoFullSelectAnimation(), "Ready.Chamber");
			}
			W1S1 DCBA 1 A_DoSelectAnim();
		goto Ready.Active;
		Ready.Chamber:
			W1D1 ABCDEFGHIJKLMNOPQRSTUVWXYZ 1 A_DoSelectAnim(-10, true);
			W1D2 ABCDEFGHIJKLMNOP 1 A_DoSelectAnim(-10, true);
		Ready.Active:
			W1G1 A 1 
			{
				A_HaloWeaponReady(WRF_ALLOWRELOAD);
				A_LCDOffset(0,0);
				
				A_Overlay(LCD_LLayer, "LCD_AmmoCount.Left");
				A_Overlay(LCD_RLayer, "LCD_AmmoCount.Right");
				A_Overlay(LCD_CLayer, "LCD_Compass");
				A_OverlayFlags(LCD_LLayer, PSPF_ADDWEAPON|PSPF_ADDBOB, true);
				A_OverlayFlags(LCD_RLayer, PSPF_ADDWEAPON|PSPF_ADDBOB, true);
				A_OverlayFlags(LCD_CLayer, PSPF_ADDWEAPON|PSPF_ADDBOB, true);
				A_OverlayScale(LCD_LLayer, 0,0, WOF_ADD);
				A_OverlayScale(LCD_RLayer, 0,0, WOF_ADD);
			}
		loop;
				
		Ready.Dryfire:
			W1G1 A 12 A_WeapSound("Halo/Weapons/DryFire", CHANF_OVERLAP);
		goto Ready.Active;

		Select:
			TNT1 A 1 A_GunRaise();
		wait;

		Deselect:
			TNT1 A 0 A_DisableLCD();
			W1S1 ABCD 1;
			W1S1 D 1 A_GunLower();
		wait;
		
		
		//  - 550RPM -
		// 550/60 = ~9.17
		// 35/9.17 = ~4 frames.
		Fire:
			TNT1 A 0 
			{				
				Name fireAnim = String.Format("W1F%d", randompick[WeapFX](1,3));
				A_SetSprite(fireAnim);
				return A_GunCheckReload();
			}
			"####" A 1 Bright
			{
				A_FireRifle();
				A_RecoilOffset(frandom[WeapFX](-4,4),frandom[WeapFX](2,2),2);
				A_SetRecoil(0.8, 0, 1);
				A_RQuakeEx(1,2,0,3,0,20,"",QF_RELATIVE|QF_WAVE);
				A_LCDOffset(4, 0);
				//A_RollQuake(1,2,2);
			}
			"####" B 1 Bright
			{
				A_Light(0);
				A_MechanismSound("Halo/Weapons/Rifle/Mech");
			}
			"####" C 1 
			{
				A_SetRecoil(-0.1, 0, 3);
				A_RecoilOffset(0,0,2);
				A_LCDOffset(8, 2);
			}
			"####" DEFGHIJKLMNOP 1 
			{
				A_LCDOffset(0, 0);
				return A_RefireState("Fire");
			}
		goto Ready.Active;
		
		// Cache all fire variations so GZDoom doesn't have an aneurism.
		Fire.Cache:
			W1F1 # 0;
			W1F2 # 0;
			W1F3 # 0;
		stop;
		
		// Ammo 10s count
		LCD_AmmoCount.Left:
			LCDL "#" 1 Bright
			{
				A_SetFrame(floor(countinv(invoker.AmmoType2)/10.), LCD_LLayer);
				A_FollowRotation(LCD_LLayer, PSP_WEAPON);
				A_OverlayOffset(LCD_LLayer, invoker.lcd_offs.x, invoker.lcd_offs.y);
				A_FollowRotatedPos(LCD_LLayer, PSP_WEAPON, (40,20));
			}
		loop;
		// Ammo 1s count
		LCD_AmmoCount.Right:
			LCDR "#" 1 Bright
			{
				A_SetFrame(floor(countinv(invoker.AmmoType2)%10.), LCD_RLayer);
				A_FollowRotation(LCD_RLayer, PSP_WEAPON);
				A_OverlayOffset(LCD_RLayer, invoker.lcd_offs.x, invoker.lcd_offs.y);
				A_FollowRotatedPos(LCD_RLayer, PSP_WEAPON, (40,20));
			}
		loop;
		
		// Compass 
		LCD_Compass:
			LCDC A 1 Bright
			{
				double snap = 360 / 8;
				double compassAngle = int((angle-90) / snap) * snap;
			
				A_OverlayPivotAlign(LCD_CLayer, PSPA_CENTER, PSPA_CENTER);
				A_OverlayPivot(LCD_CLayer, 0, 0.18);
				A_OverlayRotate(LCD_CLayer, compassAngle, WOF_INTERPOLATE);
				A_OverlayOffset(LCD_CLayer, invoker.lcd_offs.x, invoker.lcd_offs.y);
				A_FollowRotatedPos(LCD_CLayer, PSP_WEAPON, (40,20));
			}
		loop;
		
		LCD_Off:
			TNT1 A 1;
		stop;
		
		Reload:
			TNT1 A 0 A_ValidateReload("Ready.Dryfire");
			TNT1 A 0 A_DisableLCD();
			TNT1 A 0 A_ReloadSound();
			TNT1 A 0 A_JumpIf(!CountReloadAmmo(), "Reload.Empty");
		Reload.Tactical:
			W1R4 QRSTUVWXYZ 1 A_SetRecoil(0.5, 0, 1);
			W1R5 ABCDEFG 1;
			W1R5 H 1; 
			W1R5 IJKLMNOPQRSTUVWX 1;
			W1R5 Y 1
			{
				A_SetRecoil(0.2, 0.3, 1);
				A_ReloadClip();
			}
			W1R5 Z 1;
			W1R6 ABCDEFGHIJKLMNOPQRSTUVWXYZ 1;
			W1R7 ABCDEFGHIJKLMNOP 1;
			TNT1 A 0 A_GotoState("Ready.Active");
		
		Reload.Empty:
			W1R1 ABCDE 1 A_SetRecoil(0.7, 0, 1);
			W1R1 FGHIJKLMNOPQRS 1;
			W1R1 T 1 
			{
				A_SetSFXPos(10,-25,-25);	
				A_SpawnSFX("Debris_RifleMagazine", 0, 60);
			}
			W1R1 UVWXYZ 1;
			W1R2 ABCD 1;
			W1R2 E 1 
			{
				A_SetRecoil(0.6, 0.8, 1);
				A_ReloadClip();
			}
			W1R2 FGHIJKLMNO 1;
			W1R2 P 1 A_SetRecoil(0.5, 0.3, 1);
			W1R2 QRSTUVWXYZ 1;
			W1R3 ABCDEGHI 1;
			W1R3 J 1 A_SetRecoil(0.3, 0.1, 1);
			W1R3 KLMNO 1;
			W1R3 P 1 A_SetRecoil(-0.2, -0.1, 1);
			W1R3 QRSTUVWXYZ 1;
			W1R4 ABCDEFGHIJKLMNOP 1; 
		goto Ready.Active;
		
		Spawn:
			W1P1 A -1;
		stop;
	}
}

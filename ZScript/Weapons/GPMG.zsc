			"The M247 is often seen as either a stationary gun, or weilded by Spartans. "
		);
	}
	*/

	override void MarkPrecacheSounds()
	{
		// Prevent stutters by precaching weapon sounds.
		MarkSound("Halo/Weapons/GPMG/Fire");
		MarkSound("Halo/Weapons/GPMG/Fire/Bass");
		MarkSound("Halo/Weapons/GPMG/Mech");
		MarkSound("Halo/Weapons/GPMG/Reload");
		MarkSound("Halo/Weapons/GPMG/Reload/Empty");
		MarkSound("Halo/Weapons/GPMG/Draw");
	}
	
	action void A_FireGPMG(bool centered = false)
	{
		Sound fireSound = "Halo/Weapons/GPMG/Fire";
	
		A_Light(2);
		A_WeapSound(fireSound, CHANF_OVERLAP, true);
		A_WeapSound("Halo/Weapons/GPMG/Fire/Bass", CHANF_OVERLAP, true);
		
		let [hitPos, proj] = A_ShootProjectile("HaloGPMG_Bullet", centered ? 4 : 11, spreadmod:(centered ? 0.5 : 1.0), useHitscanMP:false);
		let bullet = HaloGPMG_Bullet(proj);
		if(bullet) bullet.explosiveAmmo = true;
		
		A_SetSFXPos(20,-18,-12);
		A_SpawnSFX("HighCaliburCasing", -90,-20);
		A_SetSFXPos(25,-10,-8);
		A_SpawnSFX("MuzzleSmoke", 0,0);
		A_TakeAmmo();
		A_UpdateSpread();
	}
	
	action void A_ReloadSound()
	{
		Sound reload_snd = "Halo/Weapons/GPMG/Reload";
		if(!CountLoadedAmmo()) reload_snd = "Halo/Weapons/GPMG/Reload/Empty";
		A_StartSound(reload_snd, CHAN_RELOADING, CHANF_OVERLAP);
	}
	
	override void DoEffect()
	{
		super.DoEffect();
	
		// Drop weapon if no ammo.
		if(Owner.player.ReadyWeapon != self)
		{
			if(Owner.countinv(AmmoType2) <= 0)
			{
				// Drop Energy Sword.
				DiscardWeapon("Halo_DiscardedGPMG");
			}
		}
	}
	
	States
	{	
		Ready:
			TNT1 A 4 A_WeapSound("Halo/Weapons/GPMG/Draw");
			WVD1 HGFEDDDCBA 2 A_DoSelectAnim(-5, true);
		goto Ready.Active;
		
		Ready.Active:
			WVI1 "#" 1
			{
				A_SetFrame(A_CheckInScope() ? 1 : 0);
				A_HaloWeaponReady(WRF_ALLOWRELOAD, true);
				return A_JumpIf(!CountLoadedAmmo(), "Deselect");
			}
		loop;
			
		Ready.Dryfire:
			WVI1 A 12 A_WeapSound("Halo/Weapons/DryFire", CHANF_OVERLAP);
		goto Ready.Active;

		Select:
			TNT1 A 1 A_GunRaise();
		wait;

		Deselect:
			WVD1 ABCDDEFGH 2;
		Deselect.Loop:
			WVD1 H 1 
			{
				// Needed because weapon is removed from inventory during this process.
				if(health > 0)
				{
					player.ReadyWeapon = NULL;
					player.PendingWeapon = invoker.FindNextWeapon();
				}
				A_GunLower();
			}
		loop;
		
		Fire:
			TNT1 A 0 A_JumpIf(!CountLoadedAmmo(), "Ready.DryFire");
			TNT1 A 0 A_JumpIf(A_CheckInScope(), "FireCenter");
			TNT1 A 0 A_Jump(128, "Fire.Two");
		Fire.One:
			WVF1 A 1 A_SetZoom(0.95, 2);
			WVF1 B 1 Bright
			{
				A_RecoilOffset(5,5,1);
				A_SetRecoil(1.42, 0, 1);
				A_RQuakeEx(4,2,1,3,0,20,"",QF_RELATIVE|QF_WAVE|QF_SCALEDOWN);
				A_RollQuake(2,10,1);
				A_FireGPMG();
			}
			WVF1 C 1
			{
				A_Light(0);
				A_SetZoom(1.0, 5);
				A_MechanismSound("Halo/Weapons/GPMG/Mech");
			}
			WVF1 D 1 A_RecoilOffset(0,0,6);
			WVF1 CA 1;
		goto Ready.Active;
		
		Fire.Two:
			WVF1 I 1 A_SetZoom(0.95, 2);
			WVF1 J 1 Bright
			{
				A_RecoilOffset(5,5,1);
				A_SetRecoil(1.42, 0, 1);
				A_RQuakeEx(4,2,1,3,0,20,"",QF_RELATIVE|QF_WAVE|QF_SCALEDOWN);
				A_RollQuake(2,10,1);
				A_FireGPMG();
			}
			WVF1 K 1
			{
				A_Light(0);
				A_SetZoom(1.0, 5);
				A_MechanismSound("Halo/Weapons/GPMG/Mech");
			}
			WVF1 L 1 A_RecoilOffset(0,0,4);
			WVF1 KI 1;
		goto Ready.Active;
		
		FireCenter:
			TNT1 A 0 A_Jump(128, "FireCenter.Two");
		FireCenter.One:
			WVF1 E 1 A_SetZoom(0.92, 2);
			WVF1 F 1 Bright
			{
				A_RecoilOffset(0,10,1);
				A_SetRecoil(0.95, 0, 1);
				A_RQuakeEx(4,2,1,3,0,20,"",QF_RELATIVE|QF_WAVE|QF_SCALEDOWN);
				A_RollQuake(2,4,1);
				A_FireGPMG(true);
			}
			WVF1 G 1
			{
				A_Light(0);
				A_SetZoom(1.0, 5);
				A_MechanismSound("Halo/Weapons/GPMG/Mech");
			}
			WVF1 H 1 A_RecoilOffset(0,0,6);
			WVF1 GE 1;
		goto Ready.Active;
		FireCenter.Two:
			WVF1 M 1 A_SetZoom(0.92, 2);
			WVF1 N 1 Bright
			{
				A_RecoilOffset(0,10,1);
				A_SetRecoil(0.95, 0, 1);
				A_RQuakeEx(4,2,1,3,0,20,"",QF_RELATIVE|QF_WAVE|QF_SCALEDOWN);
				A_RollQuake(2,4,1);
				A_FireGPMG(true);
			}
			WVF1 O 1
			{
				A_Light(0);
				A_SetZoom(1.0, 5);
				A_MechanismSound("Halo/Weapons/GPMG/Mech");
			}
			WVF1 P 1 A_RecoilOffset(0,0,6);
			WVF1 QO 1;
		goto Ready.Active;
		
		Spawn:
			WVP1 A -1;
		stop;
	}
}

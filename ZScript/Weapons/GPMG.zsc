class Halo_GPMG_Clip : Ammo 
{
	Default 
	{
		Inventory.MaxAmount 200;
	}
}

class HaloGPMG_Bullet : HaloBullet 
{
	bool explosiveAmmo;
	Property IsExplosive : explosiveAmmo;

	Default
	{
		HaloProjectile.SetRanges GPMG_RANGE1, GPMG_RANGE2;
		HaloProjectile.MinRangeDamage GPMG_MINDMG; 
		HaloProjectile.BaseDamage GPMG_DMG;
		HaloProjectile.Speed_MPS GPMG_BMPS;
		HaloProjectile.HeadshotDMGFactor GPMG_HEDMOD;
		HaloProjectile.RicochetChance 0;
		HaloGPMG_Bullet.IsExplosive true;
		Scale 1.3;
	}
	
	States
	{
		XDeath:
		Death:
			MODL A 2 
			{
				if(explosiveAmmo)
				{
					let expl = Spawn("GPMGBulletExplosion", pos);
					if(expl) expl.target = target;
				}
			}
		stop;
	}
}

class GPMGBulletExplosion : CheapActor
{	
	double selfDamage;
	double expThrust;
	double fragIntensity;
	double dmgScale;
	Property SelfDamageAmount : selfDamage;
	Property ExplosionThrust : expThrust;
	Property FlyingExplosionChance : fragIntensity;
	Property ExplosionDamageModifier : dmgScale;
	
	Default
	{
		Scale 0.5;
		Alpha 0.8;
		Damage 0;
		GPMGBulletExplosion.SelfDamageAmount 0.33;
		GPMGBulletExplosion.ExplosionThrust 1.0;
		GPMGBulletExplosion.FlyingExplosionChance 100;
		GPMGBulletExplosion.ExplosionDamageModifier 1.0;
		
		RenderStyle "Add";
	}
	
	States
	{
		Spawn:
			TNT1 A 0;
			TNT1 A 1 
			{
				double sm = 2.0 * scale.X;
				let splash = Spawn("LargeSplashSpawner", pos);
				if(splash) splash.A_SetScale(sm * splash.Scale.X * 2.0);
				
				let sparks = Spawn("ImpactSparks", pos);
				if(sparks) sparks.A_SetScale(sm * 0.35);
				
				let flare = Spawn("TankRocket_Flare", (pos.xy, pos.z+20));
				if(flare) 
				{
					flare.A_SetScale(sm * 0.35);
					flare.A_SetRenderStyle(0.8, STYLE_Add);
				}
				HaloMath.ExplodeEx(self, 32 * dmgScale, 128, thrustMod:expThrust, selfDamage:selfDamage, damageBosses:false, infiniteHeight:false);
			}
			SX04 ABCD 1 Bright;
			TNT1 A 0 
			{
				vector3 fxpos = (pos.xy, pos.z+40);
				if(random[FlyingExplosionRNG](0,100) <= fragIntensity) 
					HaloMath.SpawnFX("FragGrenade_FlyingExplosion", fxpos, angle, random[GPMGExplosionRNG](1,3), 10, 20, 180,45, 25);
			}
			SX04 EFGHIJKLMNOPQ 1 Bright;
		stop;
	}
}


class Halo_DiscardedGPMG : FastActor
{
	States
	{
		Spawn:
			WVP1 A -1;
		stop;
	}
}

class Halo_GPMG : HaloGun 
{	
	Default
	{
		//$Category "HaloDoom/Weapons"
		Weapon.SlotNumber 5;
		Obituary "%o was blown to bits by %k's GPAC.";
		Inventory.PickupMessage	"Picked up the M247 General Purpose Auto Cannon";
		Tag "M247 GPAC";
		Weapon.BobSpeed 2.45;
		Weapon.BobRangeX 0.80;
		Weapon.AmmoType "Halo_GPMG_Clip";
		Weapon.AmmoType2 "Halo_GPMG_Clip";
		Weapon.AmmoGive 300;
		HaloGun.Faction "Human";
				
		// Recoil
		HaloGun.Bloom 0.12;
		HaloGun.BloomSpeed 0.25;
		HaloGun.BaseRecoil GPMG_RECOIL;
		HaloGun.Inaccuracy GPMG_ACCMOD;
		HaloGun.Crosshair "TurRet", 0.7; // lmao look at me, I'm soo punny with names :P
		HaloGun.UIGraphic "WI_GPMG", 0.4, 0.4;
		HaloGun.SetupUIAmmo "WI_AMMO", 12.5, 12.5, 0, 9;
		HaloGun.UIAmmo_Scale_Offset 1.0, 0, -10;
		
		HaloGun.TwoHandedWeapon true;
		HaloGun.PowerTier P_POWER;
		HaloGun.Rarity 50;
		
		RecoilWeapon.YOffsetRange 0, 40;
	}
	
	override int GetPowerTier()
	{	
		if(HaloPlayer.IsGameType("HL2")) return P_STRONG;
		return super.GetPowerTier();
	}
	


class Halo_LightRifleMag : Ammo 
{
	Default 
	{
		Inventory.MaxAmount 42;
	}
}
class Halo_LightRifle_Reserves : Ammo
{
	mixin WorldAmmoBehavior;
	Default 
	{
		Radius 0;
		Height 0;
		Scale 0.65;

		Inventory.Amount 255;
		Inventory.MaxAmount 255;
		Inventory.Icon "";
		Inventory.PickupSound "";
		Inventory.PickupMessage "";
		Ammo.BackpackMaxAmount 300;
	}
	
	States
	{
		Spawn:
			TNT1 A -1;
		stop;
	}
}

class LSR_LightRifleDMR : LSR_BinaryRifle 
{
	Default
	{
		LaserBeam.LaserColor "#0061FF"; 
		Translation "0:255=@64[0,97,255]";
		LSR_UnmakerBeam.LaserPuff "LightRifleDMRPuff";
		LSR_BinaryRifle.LaserDamage (LIGHTRIFLE_DMG * 6.0);
	}

	override void OnImpact(vector3 hitPos, Actor hitActor)
	{
		super.OnImpact(hitPos, hitActor);
		if(!hitActor) return;
		
		if(hitActor.bCORPSE || hitActor.health <= 0)
		{
			for(int i = 0; i < 3; i++)
			{
				let expl = Coil_Hardlight_Explosion(Spawn("Coil_Hardlight_Explosion", hitPos));
				expl.translation = translation;
				expl.target = source;
				expl.plrSource = source;
			}
		}
	}
}

class LSR_LightRifle : LSR_BinaryRifle
{
	Default
	{
		Alpha 2.0;
		Scale 3.0;
		LaserBeam.LaserColor "#0061FF"; 
		LaserBeam.TrackWeapon true, PSP_WEAPON;
		LaserBeam.AimFromWeapon false;
		LSR_BinaryRifle.LaserDamage (LIGHTRIFLE_DMG);
		
		Translation "0:255=@64[0,97,255]";
		LaserBeam.LaserDecal "UnmakerDecal";
		LSR_UnmakerBeam.LaserPuff "LightRiflePuff";
		+BRIGHT;
	}
	
	override void BeamTick()
	{	
		alpha -= 0.20;
		A_SetScale(Scale.X * 0.87, Scale.Y);
	
		if(alpha <= 0.1 || Scale.X <= 0.05) Destroy();
	}
}
class LSR_LightRifleCore : LSR_LightRifle
{
	Default
	{
		Alpha 2.0;
		Scale 1.5;
		LaserBeam.LaserColor "White"; 
		LaserBeam.TrackWeapon true, PSP_WEAPON;
		LaserBeam.AimFromWeapon false;
		+BRIGHT;
	}
	
	override void OnImpact(vector3 hitPos, Actor hitActor) {}
}
